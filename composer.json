{
    "name": "drupal-composer/drupal-project",
    "description": "Project template for Drupal 8 projects with composer",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "",
            "role": ""
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^1.6.5",
        "drupal/admin_toolbar": "^3.5",
        "drupal/classy": "^2.0",
        "drupal/components": "^3.0@beta",
        "drupal/config_filter": "^2.6",
        "drupal/config_split": "^2.0",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recommended": "^11",
        "drupal/devel": "^5.0",
        "drupal/devel_entity_updates": "^5.0",
        "drupal/extlink": "^2.0",
        "drupal/honeypot": "^2.2",
        "drupal/linkit": "^7.0",
        "drupal/mailsystem": "^4.2",
        "drupal/menu_trail_by_path": "^2.1",
        "drupal/paragraphs": "^1.13",
        "drupal/pathauto": "^1.9",
        "drupal/phpmailer_smtp": "^2.2",
        "drupal/redirect": "^1.7",
        "drupal/seven": "^1.1@beta",
        "drupal/tour": "^2.0",
        "drupal/twig_field_value": "^2.0",
        "drupal/unified_twig_ext": "^1.0",
        "drupal/upgrade_status": "^4.3",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/webform": "^6.3",
        "drupal/webform_views": "^5.6",
        "drush/drush": "^13.8",
        "vlucas/phpdotenv": "^5.6",
        "webflo/drupal-finder": "^1.0.0"
    },
    "require-dev": {
        "drupal/core-dev": "^11"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        }
    },
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ],
        "files": ["load.environment.php"]
    },
    "scripts": {
        "pre-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
        ],
        "post-update-cmd": [
        ]
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-paths": {
            "html/core": ["type:drupal-core"],
            "html/libraries/{$name}": ["type:drupal-library"],
            "html/modules/contrib/{$name}": ["type:drupal-module"],
            "html/profiles/contrib/{$name}": ["type:drupal-profile"],
            "html/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"]
        },
        "patches": {
        }
    }
}
